# --- AWS / EKS ---
AWS_REGION=ap-south-1
EKS_CLUSTER_NAME=eks-dashboard
# Where the generated kubeconfig (via `aws eks update-kubeconfig`) is written.
KUBECONFIG_PATH=./generated-kubeconfig.yaml

# --- Session / JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=TUCkw6pUecDElMUbvivkNkJcKPmNdnjX4jBk3kr4RVBVjTlm3WReQ6Y0RFOZMWft
JWT_ALGORITHM=HS256
SESSION_TTL_MINUTES=480

# --- Frontend origin (CORS + redirect target after login) ---
FRONTEND_ORIGIN=http://43.205.211.6:5173

# --- OIDC / AWS SSO (IAM Identity Center) ---
# Point these at your IAM Identity Center (or any OIDC provider) OAuth app.
OIDC_ENABLED=false
OIDC_ISSUER=https://your-sso-instance.awsapps.com/start
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/auth/callback

# --- Dev-only fallback login (disable in production by leaving blank) ---
DEV_LOGIN_ENABLED=true
DEV_USERS=admin:admin123:admins

# --- RBAC mapping file ---
RBAC_MAPPING_FILE=./rbac_mapping.yaml

# --- Audit log ---
AUDIT_LOG_FILE=./audit.log
